{
  "name": "identkit",
  "version": "0.1.1",
  "description": "Identity toolkit for TypeScript: accounts, e-mail codes, passkeys, TOTP, sessions, step-up and approval evidence.",
  "license": "MIT",
  "author": "dectria GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dectria-GmbH/identkit.git"
  },
  "homepage": "https://github.com/dectria-GmbH/identkit#readme",
  "bugs": {
    "url": "https://github.com/dectria-GmbH/identkit/issues"
  },
  "keywords": [
    "identity",
    "authentication",
    "passkeys",
    "webauthn",
    "totp",
    "sessions",
    "typescript",
    "postgresql"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "files": [
    "dist",
    "migrations",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=2",
    "test:postgres": "vitest run --maxWorkers=2 test/postgres",
    "check:runtime": "node scripts/check-runtime-imports.mjs",
    "prepublishOnly": "pnpm build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm check:runtime"
  },
  "peerDependencies": {
    "kysely": ">=0.29.0 <0.30.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "kysely": "0.29.9",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "rolldown": "1.2.19",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
